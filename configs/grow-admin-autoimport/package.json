{
  "name": "@grow-admin-plugins/unplugin-auto-import",
  "version": "0.0.0",
  "type": "module",
  "description": "Grow Admin的自动导入插件",
  "license": "MIT",
  "author": {
    "name": "YuShao Zhang",
    "email": "wo_99936@qq.com",
    "url": "https://github.com/ZhQuella"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "require": "./dist/vite.cjs",
      "import": "./dist/vite.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.cjs",
      "import": "./dist/types.js"
    },
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "clean": "pnpm rimraf node_modules && pnpm rimraf dist && pnpm rimraf .turbo",
    "build": "tsup",
    "dev": "tsup --watch src",
    "build:fix": "esno scripts/postbuild.ts",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "prepack": "esno scripts/postbuild.ts"
  },
  "dependencies": {
    "@antfu/utils": "^0.7.4",
    "@rollup/pluginutils": "^5.0.2",
    "lodash-es": "^4.0.0",
    "unplugin": "^1.3.1"
  },
  "devDependencies": {
    "bumpp": "^9.1.1",
    "chalk": "^5.2.0",
    "esno": "^0.16.3",
    "fast-glob": "^3.2.12",
    "tsup": "^6.7.0",
    "typescript": "^5.1.6",
    "vite": "^4.3.9"
  }
}