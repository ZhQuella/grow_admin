{
  "name": "grow-admin-sample",
  "version": "0.0.0",
  "author": {
    "name": "YuShao Zhang",
    "email": "wo_99936@qq.com",
    "url": "https://github.com/ZhQuella"
  },
  "scripts": {
    "build": "pnpm rimraf dist && pnpm vite build --mode $NODE_ENV",
    "clean": "pnpm rimraf node_modules && pnpm rimraf dist && pnpm rimraf .turbo",
    "dev": "vite",
    "preview": "npm run build && vite preview",
    "preview:dist": "vite preview",
    "report": "pnpm cross-env REPORT=true npm run build",
    "server:br": "pnpx http-server dist --cors --brotli -c-1",
    "server:gzip": "pnpx http-server dist --cors --gzip -c-1",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@grow-admin-rock/utils": "workspace:*",
    "@grow-admin-rock/base-package": "workspace:*",
    "@grow-admin-rock/infrastructure": "workspace:*",
    "@grow-admin-rock/ioc": "workspace:*",
    "@grow-admin-rock/locale": "workspace:*",
    "vue": "~3.3.4",
    "vue-router": "^4.1.6",
    "pinia": "~2.0.34",
    "dayjs": "^1.11.7",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "@grow-admin-config/vite": "workspace:*",
    "@grow-admin-rock/types": "workspace:*",
    "@grow-admin-rock/styles": "workspace:*",
    "@types/lodash-es": "^4.17.6",
    "@vue/compiler-sfc": "~3.2.0",
    "@vue/test-utils": "^2.2.9",
    "rollup": "^3.19.1",
    "typescript": "^5.1.6",
    "vite": "4.3.9",
    "vite-plugin-mock": "^2.9.6",
    "vue-tsc": "^1.0.24",
    "mockjs": "^1.1.0"
  }
}
