    "@grow-admin-rock/component-driver-element-plus": "workspace:*",
    "@grow-admin-rock/component-driver-naive": "workspace:*",
    "@grow-admin-rock/components": "workspace:*",
    "@grow-admin-rock/constants": "workspace:*",
    "@grow-admin-rock/infrastructure": "workspace:*",
    "@grow-admin-rock/ioc": "workspace:*",
    "@grow-admin-rock/locale": "workspace:*",
    "@grow-admin-rock/types": "workspace:*",
    "@grow-admin-rock/utils": "workspace:*",
    "@grow-admin-rock/layouts": "workspace:*",
