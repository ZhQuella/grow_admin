    "@iconify/iconify": "^3.1.1",
    "@purge-icons/generated": "^0.9.0",
    "dayjs": "^1.11.7",
    "element-plus": "^2.4.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.0",
    "naive-ui": "^2.38.1",
